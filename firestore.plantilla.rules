rules_version = '2';
// Reglas de la tienda. Los correos de los dueños se ponen al compilar (scripts/preparar.mjs) desde src/cliente.json.
// Dueño: todo. Vendedores: inventario, selecciones y proformas, sin costos. Público: solo los enlaces que le mandan.
service cloud.firestore {
  match /databases/{database}/documents {
    function conSesion() { return request.auth != null; }
    function esAdmin() {
      return conSesion() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [__CORREOS_ADMIN__];
    }
    function rutaUsuario() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function esVendedor() {
      return conSesion() && exists(rutaUsuario()) && get(rutaUsuario()).data.rol == 'vendedor'
        && get(rutaUsuario()).data.get('activo', true) == true;
    }
    function esEquipo() { return esAdmin() || esVendedor(); }

    // Datos de la tienda: los ve también el cliente en sus enlaces (nombre, teléfono, dirección).
    match /ajustes/general {
      allow get: if true;
      allow list: if esEquipo();
      allow write: if esAdmin();
    }

    // Fotos de fondo del catálogo (una por tema): las ve cualquiera; solo el dueño las cambia.
    match /fondos/{id} {
      allow get: if true;
      allow list, write: if esAdmin();
    }

    // El equipo crea vitrinas y segmentos; solo el dueño las borra.
    match /vitrinas/{id} {
      allow read: if esEquipo();
      allow create, update: if esEquipo();
      allow delete: if esAdmin();
    }

    // Catálogo en línea: el dueño lo enciende en Ajustes (catalogo = true).
    function catalogoAbierto() {
      return get(/databases/$(database)/documents/ajustes/general).data.get('catalogo', false) == true;
    }

    match /productos/{id} {
      // El equipo ve todo. Con el catálogo encendido, cualquiera ve los que están disponibles (en exhibición o en bodega).
      allow read: if esEquipo() || (catalogoAbierto() && resource.data.estado in ['exhibicion', 'bodega']);
      allow delete: if esAdmin();
      // Los colaboradores también agregan productos nuevos (sin costo, que va aparte), pero no los venden al crearlos.
      allow create: if esAdmin() || (esVendedor()
        && request.resource.data.keys().hasOnly(['marca', 'modelo', 'codigo', 'estilo', 'material', 'color', 'descripcion', 'precio', 'fotos', 'miniatura', 'estado', 'vitrinaId', 'segmento', 'actualizado', 'creado', 'creadoPor', 'creadoPorNombre'])
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.precio is number && request.resource.data.precio > 0
        && request.resource.data.estado in ['exhibicion', 'bodega', 'apartado']);
      // Los vendedores pueden mover, apartar, vender y cambiar fotos; el dueño cambia todo.
      allow update: if esAdmin() || (esVendedor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'vitrinaId', 'segmento', 'actualizado', 'vendidoEn', 'fotos', 'miniatura', 'estadoAntes']));
    }

    // Costos aparte: solo el dueño.
    match /costos/{id} {
      allow read, write: if esAdmin();
    }

    // Gastos del negocio (renta, salarios, otros): solo el dueño.
    match /gastos/{id} {
      allow read, write: if esAdmin();
    }

    // Caja chica (efectivo): el dueño y los colaboradores la ven y la manejan.
    match /caja/{id} {
      allow read, write: if esEquipo();
    }

    // Servicios y accesorios cobrados: el equipo registra; solo el dueño quita un cobro.
    match /cobros/{id} {
      allow read: if esEquipo();
      allow create: if esEquipo() && request.resource.data.por == request.auth.uid;
      allow delete: if esAdmin();
    }

    // Accesorios (baterías, tornillos…) con existencias.
    match /accesorios/{id} {
      allow read, create, update: if esEquipo();
      allow delete: if esAdmin();
    }

    // Fotos grandes. Se pueden abrir sin sesión (el cliente las ve en su enlace) pero no listar.
    match /fotos/{id} {
      allow get: if true;
      allow list: if esEquipo();
      // El equipo (dueño y vendedores) agrega y quita fotos de los productos.
      allow create, update, delete: if esEquipo();
    }

    match /movimientos/{id} {
      allow read: if esEquipo();
      allow create: if esEquipo() && request.resource.data.por == request.auth.uid;
      allow update, delete: if esAdmin();
    }

    // Enlace para el cliente: el código largo es el id. El cliente solo puede marcar lo que le gustó.
    match /selecciones/{id} {
      allow get: if esEquipo() || resource.data.vence > request.time;
      allow list: if esEquipo();
      allow create: if esEquipo() && request.resource.data.vendedorUid == request.auth.uid;
      allow delete: if esAdmin() || (esVendedor() && resource.data.vendedorUid == request.auth.uid);
      allow update: if esEquipo()
        || (resource.data.vence > request.time
            && resource.data.estado in ['enviada', 'respondida']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['elegidos', 'nota', 'estado', 'respondida'])
            && request.resource.data.estado == 'respondida'
            && request.resource.data.elegidos is list
            && request.resource.data.elegidos.size() <= resource.data.items.size()
            && request.resource.data.nota is string && request.resource.data.nota.size() <= 500
            && request.resource.data.respondida == request.time);
    }

    // Proformas: el id es largo y sirve de enlace para el cliente.
    match /proformas/{id} {
      allow get: if true;
      allow list: if esEquipo();
      allow create: if esEquipo() && request.resource.data.vendedorUid == request.auth.uid;
      allow update: if esAdmin() || (esVendedor() && resource.data.vendedorUid == request.auth.uid);
      allow delete: if esAdmin();
    }

    // Invitaciones para vendedores: el código es el id del documento. Solo se puede usar una vez.
    match /invitaciones/{codigo} {
      allow get: if conSesion();
      allow list, create, delete: if esAdmin();
      allow update: if esAdmin()
        || (conSesion() && resource.data.usada == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usada', 'uid'])
            && request.resource.data.usada == true && request.resource.data.uid == request.auth.uid
            && getAfter(rutaUsuario()).data.codigo == codigo);
    }

    match /usuarios/{uid} {
      allow read: if esAdmin() || (conSesion() && request.auth.uid == uid);
      allow create: if conSesion() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['rol', 'codigo', 'nombre', 'correo', 'telefono', 'activo'])
        && request.resource.data.rol == 'vendedor' && request.resource.data.activo == true
        && get(/databases/$(database)/documents/invitaciones/$(request.resource.data.codigo)).data.usada == false;
      allow update: if esAdmin() || (conSesion() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['foto'])
        && request.resource.data.get('foto', '') is string && request.resource.data.get('foto', '').size() <= 60000);
      allow delete: if esAdmin();
    }
  }
}
